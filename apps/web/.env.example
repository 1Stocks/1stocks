# Public address of a Solana wallet used only to request LI.FI quotes.
LIFI_QUOTE_FROM_ADDRESS=
# Optional and server-only.
LIFI_API_KEY=
# Optional. Set true in approved, isolated preview environments.
APPLE_MULTICHAIN_QUOTE_PREVIEW=

# Public IDs from the Privy dashboard. Use http://localhost:3000 for local development
# and follow apps/web/README.md for Google OAuth settings. Client ID is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional server-side HTTPS RPC URL for reading SOL balances on Solana devnet.
SOLANA_DEVNET_RPC_URL=
