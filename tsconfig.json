{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/*"],
      "@1stocks/api": ["./apps/api/src/index.ts"],
      "@1stocks/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["apps/web/**/*.ts", "apps/web/**/*.tsx"],
  "exclude": ["node_modules", "apps/web/.next"]
}
