{
  "name": "1stocks-mvp",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname localhost --port 3000",
    "start": "next start apps/web",
    "lint": "eslint apps packages",
    "test": "tsx --tsconfig tsconfig.base.json --test apps/api/test/*.test.ts apps/web/test/*.test.ts packages/shared/test/*.test.ts",
    "typecheck": "tsc -p apps/api && tsc -p packages/shared && next typegen apps/web && tsc -p apps/web",
    "build": "npm run typecheck && next build apps/web",
    "check": "npm run lint && npm test && npm run build",
    "verify": "npm ci && npm run check"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.52.1",
    "@solana-program/memo": "0.16.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "next": "16.4.6",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "server-only": "0.0.1",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.82.0",
    "shadcn": "^4.23.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.34",
    "tailwindcss": "4.3.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
